{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*).pdf", "headers": [{ "key": "Content-Disposition", "value": "inline" }, { "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
